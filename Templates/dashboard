<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TwitchBot — Dashboard</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
  <style>
    *{box-sizing:border-box;margin:0;padding:0}
    :root{
      --bg:#080c14;--surf:#0f1520;--surf2:#141c2e;--border:#1e2840;
      --purple:#9146ff;--purpled:#7b2fff;--purpleg:rgba(145,70,255,.12);
      --green:#0dffc8;--red:#ff4757;--yellow:#ffcc00;--blue:#4ea8ff;
      --text:#c8d4f0;--muted:#4a5778;
      --ui:'Syne',sans-serif;--mono:'Space Mono',monospace;
    }
    html,body{background:var(--bg);color:var(--text);font-family:var(--ui)}
    body{background-image:linear-gradient(rgba(145,70,255,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(145,70,255,.03) 1px,transparent 1px);background-size:32px 32px;min-height:100vh}
    .shell{max-width:940px;margin:0 auto;padding:2rem 1.5rem 4rem}
    header{display:flex;align-items:center;justify-content:space-between;margin-bottom:2.5rem;padding-bottom:1.5rem;border-bottom:1px solid var(--border)}
    .logo{display:flex;align-items:center;gap:.75rem}
    .logo-icon{width:40px;height:40px;background:var(--purple);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.3rem;box-shadow:0 0 24px rgba(145,70,255,.45)}
    .logo h1{font-size:1.25rem;font-weight:800;color:#fff;letter-spacing:-.02em}
    .logo span{font-size:.68rem;color:var(--muted);font-family:var(--mono);display:block}
    .header-right{display:flex;align-items:center;gap:.75rem}
    .user-pill{font-family:var(--mono);font-size:.78rem;color:var(--muted);background:var(--surf);border:1px solid var(--border);border-radius:999px;padding:.35rem .85rem}
    .user-pill strong{color:var(--text)}
    .btn-logout{background:none;border:1px solid var(--border);border-radius:8px;padding:.35rem .75rem;color:var(--muted);font-size:.75rem;cursor:pointer;font-family:var(--mono);transition:all .2s}
    .btn-logout:hover{border-color:var(--red);color:var(--red)}
    .card{background:var(--surf);border:1px solid var(--border);border-radius:16px;padding:1.75rem;margin-bottom:1.25rem}
    .card-title{font-size:.63rem;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-family:var(--mono);margin-bottom:1.25rem}

    /* Status banner */
    .status-banner{border-radius:14px;padding:1.25rem 1.5rem;display:flex;align-items:center;gap:1rem;margin-bottom:1.25rem;border:1px solid}
    .status-banner.pending{background:rgba(255,204,0,.06);border-color:rgba(255,204,0,.25)}
    .status-banner.active{background:rgba(13,255,200,.06);border-color:rgba(13,255,200,.2)}
    .status-banner.inactive{background:rgba(74,87,120,.08);border-color:var(--border)}
    .banner-icon{font-size:1.75rem;flex-shrink:0}
    .banner-title{font-size:1rem;font-weight:700;color:#fff;margin-bottom:.25rem}
    .banner-desc{font-size:.82rem;color:var(--muted);line-height:1.55}
    .banner-desc strong{font-family:var(--mono);background:var(--surf2);padding:2px 7px;border-radius:5px;color:var(--text)}

    /* Activation steps */
    .steps{display:flex;flex-direction:column;gap:.6rem;margin-top:.75rem}
    .step-item{display:flex;align-items:flex-start;gap:.75rem;font-size:.82rem;color:var(--muted);line-height:1.5}
    .step-num{width:22px;height:22px;border-radius:50%;border:1px solid var(--border);display:flex;align-items:center;justify-content:center;font-size:.65rem;font-weight:700;font-family:var(--mono);flex-shrink:0;margin-top:1px;color:var(--purple);border-color:var(--purple)}
    code{font-family:var(--mono);background:var(--surf2);border:1px solid var(--border);padding:1px 7px;border-radius:5px;font-size:.82rem;color:var(--text)}

    /* Commands */
    .cmd-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
    @media(max-width:560px){.cmd-grid{grid-template-columns:1fr}}
    .cmd-card{background:var(--surf2);border:1px solid var(--border);border-radius:12px;padding:1rem 1.25rem}
    .cmd-name{font-family:var(--mono);font-size:.9rem;font-weight:700;color:var(--purple);margin-bottom:.3rem}
    .cmd-desc{font-size:.78rem;color:var(--muted);line-height:1.5}

    /* Log terminal */
    .log-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem}
    .log-terminal{background:#04070f;border:1px solid var(--border);border-radius:12px;height:240px;overflow-y:auto;padding:1rem;font-family:var(--mono);font-size:.78rem;line-height:1.9}
    .log-terminal::-webkit-scrollbar{width:4px}
    .log-terminal::-webkit-scrollbar-thumb{background:var(--border);border-radius:99px}
    .log-line{display:flex;gap:.75rem}
    .log-time{color:var(--muted);flex-shrink:0}
    .log-line.info .log-msg{color:var(--text)}
    .log-line.success .log-msg{color:var(--green)}
    .log-line.error .log-msg{color:var(--red)}
    .log-line.warning .log-msg{color:var(--yellow)}
    .log-line.command .log-msg{color:var(--purple);font-weight:700}
    .log-empty{color:var(--muted);font-style:italic;text-align:center;padding-top:1.5rem;font-family:var(--mono);font-size:.78rem}
    .log-count{font-family:var(--mono);font-size:.72rem;color:var(--muted)}
    .btn-clear{background:none;border:none;color:var(--muted);font-family:var(--mono);font-size:.72rem;cursor:pointer;padding:.25rem .6rem;border-radius:6px}
    .btn-clear:hover{background:var(--border);color:var(--text)}

    /* Admin section */
    .admin-badge{font-size:.68rem;font-family:var(--mono);background:var(--purpleg);border:1px solid rgba(145,70,255,.3);color:var(--purple);border-radius:999px;padding:2px 9px;margin-left:.5rem}
    .grid-2{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}
    @media(max-width:580px){.grid-2{grid-template-columns:1fr}}
    .field{display:flex;flex-direction:column;gap:.45rem}
    label{font-size:.78rem;font-weight:600;color:#7a8cb0;letter-spacing:.03em}
    input,textarea{width:100%;background:var(--bg);border:1px solid var(--border);border-radius:10px;color:var(--text);font-family:var(--mono);font-size:.82rem;padding:.7rem 1rem;outline:none;transition:border-color .2s,box-shadow .2s}
    input:focus,textarea:focus{border-color:var(--purple);box-shadow:0 0 0 3px var(--purpleg)}
    textarea{resize:vertical;min-height:65px;line-height:1.5}
    .hint{font-size:.7rem;color:var(--muted);font-family:var(--mono)}
    .btn{padding:.7rem 1.25rem;border-radius:10px;border:none;font-family:var(--ui);font-size:.85rem;font-weight:700;cursor:pointer;transition:all .2s;display:inline-flex;align-items:center;gap:.4rem}
    .btn-primary{background:var(--purple);color:#fff;box-shadow:0 4px 16px rgba(145,70,255,.3)}
    .btn-primary:hover:not(:disabled){background:var(--purpled);transform:translateY(-1px)}
    .btn-danger{background:transparent;border:1px solid rgba(255,71,87,.3);color:var(--red)}
    .btn-danger:hover:not(:disabled){background:rgba(255,71,87,.1)}
    .btn-ghost{background:transparent;border:1px solid var(--border);color:var(--muted)}
    .btn-ghost:hover:not(:disabled){border-color:var(--text);color:var(--text)}
    .btn:disabled{opacity:.35;cursor:not-allowed;transform:none}
    .controls{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1rem}
    .alert{border-radius:9px;padding:.65rem .9rem;font-family:var(--mono);font-size:.78rem;display:none;margin-top:.75rem}
    .alert.error{background:rgba(255,71,87,.1);border:1px solid rgba(255,71,87,.3);color:var(--red)}
    .alert.success{background:rgba(13,255,200,.08);border:1px solid rgba(13,255,200,.2);color:var(--green)}
    .alert.show{display:block}

    /* Users table */
    .user-table{width:100%;border-collapse:collapse;font-size:.82rem}
    .user-table th{text-align:left;padding:.6rem .75rem;font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);font-family:var(--mono);border-bottom:1px solid var(--border)}
    .user-table td{padding:.65rem .75rem;border-bottom:1px solid rgba(30,40,64,.5);vertical-align:middle}
    .user-table tr:last-child td{border-bottom:none}
    .user-table tr:hover td{background:var(--surf2)}
    .status-pill{font-family:var(--mono);font-size:.7rem;padding:2px 9px;border-radius:999px;border:1px solid}
    .status-pill.active{background:rgba(13,255,200,.08);border-color:rgba(13,255,200,.25);color:var(--green)}
    .status-pill.pending{background:rgba(255,204,0,.08);border-color:rgba(255,204,0,.25);color:var(--yellow)}
    .dot{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:4px}
    .dot.on{background:var(--green);box-shadow:0 0 6px var(--green)}
    .dot.off{background:var(--muted)}
    .btn-sm{padding:.3rem .65rem;font-size:.72rem;border-radius:7px}
    .bot-status{display:flex;align-items:center;gap:.6rem;padding:.45rem .9rem;border-radius:999px;border:1px solid var(--border);background:var(--surf2);font-size:.78rem;font-family:var(--mono);color:var(--muted)}
    .bot-status.on{border-color:rgba(13,255,200,.3);color:var(--green)}
    .bot-dot{width:8px;height:8px;border-radius:50%;background:var(--muted)}
    .bot-status.on .bot-dot{background:var(--green);box-shadow:0 0 8px var(--green);animation:pulse 2s infinite}
    @keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.5;transform:scale(.75)}}
    #adminSection{display:none}
  </style>
</head>
<body>
<div class="shell">

  <header>
    <div class="logo">
      <div class="logo-icon">🤖</div>
      <div>
        <h1>TwitchBot Panel</h1>
        <span>Multi-canal · 24/7</span>
      </div>
    </div>
    <div class="header-right">
      <div class="user-pill">Connecté : <strong id="headerUser">...</strong></div>
      <button class="btn-logout" onclick="window.location='/logout'">Déconnexion</button>
    </div>
  </header>

  <!-- Status banner -->
  <div id="statusBanner" class="status-banner inactive">
    <div class="banner-icon" id="bannerIcon">⏳</div>
    <div>
      <div class="banner-title" id="bannerTitle">Chargement...</div>
      <div class="banner-desc" id="bannerDesc"></div>
    </div>
  </div>

  <!-- Commandes actives -->
  <div class="card" id="cmdCard" style="display:none">
    <div class="card-title">⚡ Commandes disponibles sur ton canal</div>
    <div class="cmd-grid">
      <div class="cmd-card">
        <div class="cmd-name">!lurk</div>
        <div class="cmd-desc">Le viewer annonce qu'il passe en mode lurk. Le bot envoie le message personnalisé dans le chat.</div>
      </div>
      <div class="cmd-card">
        <div class="cmd-name">!unlurk</div>
        <div class="cmd-desc">Le viewer annonce son retour du lurk. Le bot le souhaite la bienvenue dans le chat.</div>
      </div>
    </div>
  </div>

  <!-- Journal -->
  <div class="card">
    <div class="log-header">
      <div class="card-title" style="margin:0">📡 Journal de ton canal</div>
      <div style="display:flex;gap:.5rem;align-items:center">
        <span class="log-count" id="logCount">0 entrée(s)</span>
        <button class="btn-clear" onclick="clearLogs()">Effacer</button>
      </div>
    </div>
    <div class="log-terminal" id="logTerminal">
      <div class="log-empty">Aucune activité pour l'instant...</div>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════ -->
  <!-- SECTION ADMIN -->
  <!-- ═══════════════════════════════════════════ -->
  <div id="adminSection">

    <div class="card">
      <div class="card-title">🔧 Configuration du bot<span class="admin-badge">ADMIN</span></div>
      <div class="grid-2" style="margin-bottom:1rem">
        <div class="field">
          <label>Token OAuth du bot</label>
          <input type="password" id="adminToken" placeholder="oauth:xxxxxxxxxxxxxxxx">
          <p class="hint">Ton bot Twitch — <a href="https://twitchtokengenerator.com" target="_blank" style="color:var(--purple)">twitchtokengenerator.com</a></p>
        </div>
        <div style="display:flex;flex-direction:column;gap:.75rem">
          <div class="field">
            <label>Message !lurk</label>
            <textarea id="adminLurkMsg" rows="2">{user} part en lurk 👀🌿</textarea>
          </div>
          <div class="field">
            <label>Message !unlurk</label>
            <textarea id="adminUnlurkMsg" rows="2">👋 {user} est de retour !</textarea>
          </div>
        </div>
      </div>
      <button class="btn btn-primary" onclick="saveConfig()">💾 Sauvegarder la config</button>
      <div class="alert" id="alertConfig"></div>
    </div>

    <div class="card">
      <div class="card-title" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem">
        <span>🎛️ Contrôle du bot<span class="admin-badge">ADMIN</span></span>
        <div class="bot-status" id="botStatusBadge"><div class="bot-dot"></div><span id="botStatusText">Hors ligne</span></div>
      </div>
      <div class="controls">
        <button class="btn btn-primary" id="btnStart" onclick="startBot()">▶ Démarrer</button>
        <button class="btn btn-danger"  id="btnStop"  onclick="stopBot()" disabled>⏹ Arrêter</button>
      </div>
      <div class="alert" id="alertBot"></div>
    </div>

    <div class="card">
      <div class="card-title">👥 Utilisateurs inscrits<span class="admin-badge">ADMIN</span></div>
      <table class="user-table">
        <thead>
          <tr><th>Utilisateur</th><th>Canal</th><th>Statut</th><th>Bot</th><th></th></tr>
        </thead>
        <tbody id="userTableBody">
          <tr><td colspan="5" style="color:var(--muted);font-family:var(--mono);font-size:.78rem;text-align:center;padding:1rem">Chargement...</td></tr>
        </tbody>
      </table>
    </div>

    <!-- Logs admin complets -->
    <div class="card">
      <div class="log-header">
        <div class="card-title" style="margin:0">📡 Journal complet<span class="admin-badge">ADMIN</span></div>
        <div style="display:flex;gap:.5rem;align-items:center">
          <span class="log-count" id="adminLogCount">0 entrée(s)</span>
          <button class="btn-clear" onclick="clearAdminLogs()">Effacer</button>
        </div>
      </div>
      <div class="log-terminal" id="adminLogTerminal">
        <div class="log-empty">En attente d'activité...</div>
      </div>
    </div>
  </div>

</div>

<script>
  let isAdmin = false;
  let myChannel = '';
  let myStatus  = '';
  let seenLogs  = 0;
  let seenAdminLogs = 0;

  function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

  function showAlert(id, msg, type='error'){
    const el = document.getElementById(id);
    el.textContent = msg; el.className = 'alert '+type+' show';
    setTimeout(()=>el.classList.remove('show'), 5000);
  }

  function renderBanner(data){
    const banner = document.getElementById('statusBanner');
    const icon   = document.getElementById('bannerIcon');
    const title  = document.getElementById('bannerTitle');
    const desc   = document.getElementById('bannerDesc');
    const cmdCard = document.getElementById('cmdCard');

    myChannel = data.channel;
    myStatus  = data.status;

    if(data.status === 'active' && data.connected){
      banner.className = 'status-banner active';
      icon.textContent = '✅';
      title.textContent = 'Bot actif sur #' + data.channel;
      desc.innerHTML = 'Le bot est connecté et prêt. Les commandes <strong>!lurk</strong> et <strong>!unlurk</strong> sont disponibles dans ton chat.';
      cmdCard.style.display = 'block';
    } else if(data.status === 'active' && !data.connected){
      banner.className = 'status-banner inactive';
      icon.textContent = '🔄';
      title.textContent = 'Canal enregistré — bot en cours de connexion';
      desc.innerHTML = 'Le bot rejoint <strong>#'+esc(data.channel)+'</strong>...';
      cmdCard.style.display = 'none';
    } else if(data.status === 'pending'){
      banner.className = 'status-banner pending';
      icon.textContent = '⏳';
      title.textContent = 'Activation requise pour #' + data.channel;
      desc.innerHTML = 'Tape <strong>!addbot</strong> dans ton chat Twitch pour activer le bot sur ton canal.';
      cmdCard.style.display = 'none';

      // Affiche les étapes si pas déjà là
      if(!document.getElementById('activationSteps')){
        const steps = document.createElement('div');
        steps.id = 'activationSteps';
        steps.className = 'steps';
        steps.innerHTML =
          '<div class="step-item"><div class="step-num">1</div><span>Ouvre ton stream ou ton chat Twitch sur <strong style="color:var(--text)">twitch.tv/'+esc(data.channel)+'</strong></span></div>' +
          '<div class="step-item"><div class="step-num">2</div><span>Tape dans le chat : <code>!addbot</code></span></div>' +
          '<div class="step-item"><div class="step-num">3</div><span>Le bot répondra et cette page se mettra à jour automatiquement ✅</span></div>';
        desc.after(steps);
      }
    } else {
      banner.className = 'status-banner inactive';
      icon.textContent = '❓';
      title.textContent = 'Statut inconnu';
      cmdCard.style.display = 'none';
    }
  }

  function renderLogs(newLogs, termId, countId, seenRef){
    if(!newLogs || newLogs.length === 0) return seenRef;
    const term = document.getElementById(termId);
    const atBottom = term.scrollHeight - term.scrollTop <= term.clientHeight + 40;
    const empty = term.querySelector('.log-empty');
    if(empty) empty.remove();
    const toAdd = newLogs.slice(seenRef);
    seenRef = newLogs.length;
    toAdd.forEach(log => {
      const line = document.createElement('div');
      line.className = 'log-line '+(log.level||'info');
      line.innerHTML = '<span class="log-time">'+log.time+'</span><span class="log-msg">'+esc(log.msg)+'</span>';
      term.appendChild(line);
    });
    document.getElementById(countId).textContent = newLogs.length+' entrée(s)';
    if(atBottom) term.scrollTop = term.scrollHeight;
    return seenRef;
  }

  function clearLogs(){
    document.getElementById('logTerminal').innerHTML = '<div class="log-empty">Journal effacé.</div>';
    seenLogs = 0; document.getElementById('logCount').textContent='0 entrée(s)';
  }
  function clearAdminLogs(){
    document.getElementById('adminLogTerminal').innerHTML = '<div class="log-empty">Journal effacé.</div>';
    seenAdminLogs = 0; document.getElementById('adminLogCount').textContent='0 entrée(s)';
  }

  // ── Admin : table utilisateurs ──
  function renderUserTable(users, botRunning){
    const tbody = document.getElementById('userTableBody');
    tbody.innerHTML = '';
    users.forEach(u => {
      const tr = document.createElement('tr');
      tr.innerHTML =
        '<td style="font-family:var(--mono);color:var(--text)">'+(u.admin?'👑 ':'')+esc(u.username)+'</td>'+
        '<td style="color:var(--purple);font-family:var(--mono)">#'+esc(u.channel)+'</td>'+
        '<td><span class="status-pill '+u.status+'">'+u.status+'</span></td>'+
        '<td><span class="dot '+(u.connected?'on':'off')+'"></span>'+(u.connected?'Connecté':'Hors ligne')+'</td>'+
        '<td>'+(u.admin?'':('<button class="btn btn-danger btn-sm" onclick="removeUser(\''+u.username+'\')">✕</button>'))+'</td>';
      tbody.appendChild(tr);
    });

    const badge = document.getElementById('botStatusBadge');
    const text  = document.getElementById('botStatusText');
    if(botRunning){
      badge.className = 'bot-status on'; text.textContent = 'En ligne';
      document.getElementById('btnStart').disabled = true;
      document.getElementById('btnStop').disabled  = false;
    } else {
      badge.className = 'bot-status'; text.textContent = 'Hors ligne';
      document.getElementById('btnStart').disabled = false;
      document.getElementById('btnStop').disabled  = true;
    }
  }

  async function removeUser(username){
    if(!confirm('Supprimer '+username+' et retirer son canal ?')) return;
    const res  = await fetch('/api/admin/user/remove',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username})});
    const data = await res.json();
    if(!res.ok) alert(data.error); else poll();
  }

  // ── Admin : config ──
  async function saveConfig(){
    const res = await fetch('/api/admin/config',{
      method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({
        bot_token:      document.getElementById('adminToken').value||undefined,
        lurk_message:   document.getElementById('adminLurkMsg').value,
        unlurk_message: document.getElementById('adminUnlurkMsg').value
      })
    });
    const data = await res.json();
    if(res.ok) showAlert('alertConfig','✅ Config sauvegardée !','success');
    else showAlert('alertConfig','❌ '+data.error);
  }

  async function startBot(){
    document.getElementById('btnStart').disabled=true;
    document.getElementById('btnStart').textContent='⏳ Démarrage...';
    const res = await fetch('/api/admin/bot/start',{method:'POST'});
    const data = await res.json();
    if(!res.ok){ showAlert('alertBot','❌ '+(data.error||'Erreur')); document.getElementById('btnStart').disabled=false; document.getElementById('btnStart').textContent='▶ Démarrer'; }
    else { showAlert('alertBot','✅ Bot en cours de démarrage...','success'); setTimeout(poll,1500); }
  }

  async function stopBot(){
    document.getElementById('btnStop').disabled=true;
    await fetch('/api/admin/bot/stop',{method:'POST'});
    setTimeout(poll,1200);
  }

  // ── Poll ──
  async function poll(){
    try {
      // Données utilisateur
      const meData = await fetch('/api/me').then(r=>r.json());
      document.getElementById('headerUser').textContent = meData.username;
      renderBanner(meData);
      seenLogs = renderLogs(meData.logs, 'logTerminal', 'logCount', seenLogs);
      isAdmin = meData.admin;

      if(isAdmin){
        document.getElementById('adminSection').style.display='block';
        const adminData = await fetch('/api/admin/users').then(r=>r.json());
        renderUserTable(adminData.users, adminData.bot_running);
        seenAdminLogs = renderLogs(adminData.logs, 'adminLogTerminal', 'adminLogCount', seenAdminLogs);
      }
    } catch(_){}
  }

  // ── Charger config admin ──
  async function loadAdminConfig(){
    try {
      const data = await fetch('/api/admin/config').then(r=>r.json());
      if(data.lurk_message)   document.getElementById('adminLurkMsg').value   = data.lurk_message;
      if(data.unlurk_message) document.getElementById('adminUnlurkMsg').value = data.unlurk_message;
    } catch(_){}
  }

  poll();
  setInterval(poll, 3000);
  setTimeout(loadAdminConfig, 500);
</script>
</body>
</html>
